# Copy to .env and `set -a; source .env; set +a` before `python3 -m rpi`.
# The laptop's IP changes every session: read it off the planner's startup log.
export RPI_PLANNER_URL=http://192.168.1.20:5000
export RPI_VISION_URL=http://192.168.1.20:4000
# STM reply model. DONE (the default): ACK on receipt, DONE,<verb> when the motion ends.
# ACK: the ACK itself arrives when the motion ends (older firmware only).
#export RPI_STM_COMPLETION=DONE
# Motor trim and steering lock pushed at startup; leave unset to keep the firmware defaults
#export RPI_MOTOR_A_PCT=50
#export RPI_MOTOR_B_PCT=50
#export RPI_STEER_STEPS=5
