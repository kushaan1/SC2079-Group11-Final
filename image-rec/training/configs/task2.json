    "project": "training/runs/task2",
    "run_name": "yolov8n-arrows",
    "backend_preference": ["cuda", "rocm", "directml", "mps", "cpu"]
  },
  "export": {
    "enabled": true,
    "image_size": 320,
    "calibration_fraction": 1.0,
    "output_name": "best_arrows.tflite"
  }
